# ---- Postgres (Supabase) via Supavisor ----
# Transaction mode (porta 6543) + pgbouncer=true — usado em runtime pela app.
# connection_limit baixo (1-3) porque cada invocação serverless abre seu próprio pool.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"

# Conexão direta (porta 5432), sem pooler — usada apenas por `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase (Storage + Realtime apenas — NÃO usado para Auth nem queries relacionais) ----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- Auth própria (JWT em cookie httpOnly) ----
# Segredo usado para assinar/verificar o JWT de sessão (jose). Gere com: openssl rand -base64 48
JWT_SECRET="<gere-um-segredo-forte>"

# ---- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"

# ---- Envio de e-mail (SMTP, usado na recuperação de senha) ----
# Qualquer caixa SMTP serve. Gmail: host smtp.gmail.com, porta 587 e uma
# "senha de app" (exige 2FA na conta) — a senha normal NÃO funciona.
# Sem estas variáveis, em desenvolvimento o e-mail é impresso no terminal;
# em produção a Server Action falha com erro explícito.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="conta@dominio.com"
SMTP_PASSWORD="<senha-de-app>"
SMTP_FROM="Semana Fluxo <conta@dominio.com>"

# URL pública da app, usada para montar o link absoluto do e-mail de
# recuperação. Na Vercel, cai para VERCEL_PROJECT_PRODUCTION_URL se ausente.
NEXT_PUBLIC_APP_URL="https://semanafluxo.vercel.app"

# ---- Cron ----
# Header esperado pelo endpoint de cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="<gere-um-segredo-forte>"

# ---- Load testing (ver load-tests/README.md) ----
# Habilita o endpoint temporário /api/_loadtest/scan (sem auth por sessão,
# recebe participanteId direto no body). Deixe ausente/false em produção;
# só setar "true" ao rodar o k6 contra staging.
ENABLE_LOADTEST_ENDPOINT="false"
