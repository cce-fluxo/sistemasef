# Copie este arquivo para .env.loadtest (fora do git) e preencha com valores
# reais de um ambiente de STAGING. Nunca commitar .env.loadtest nem colar
# valores reais aqui. Ver load-tests/README.md para o passo a passo completo.

# URL base do ambiente de staging contra o qual o teste vai rodar.
# Nunca aponte para produção.
BASE_URL=https://seu-evento-staging.vercel.app

# Só necessário se você estiver usando a Server Action diretamente (ver
# comentários no topo de stress-test-qr-scan.js). Capture no DevTools > Network
# > filtro Fetch/XHR, no header "Next-Action" da requisição de scan.
NEXT_ACTION_HASH=

# Só necessário junto com NEXT_ACTION_HASH. O cookie de sessão JWT httpOnly
# ("session=..."), copiado do DevTools > Application > Cookies (ou do header
# "Cookie" da requisição no Network tab) depois de logar manualmente no app.
# Expira com o TTL da sessão (curto) -- se o teste começar a tomar 401 em
# massa, recapture um novo.
SESSION_COOKIE=

# --- Opção A (Route Handler /api/loadtest-scan/scan) ---
# As listas de QR codes e participanteId já vêm embutidas em
# stress-test-qr-scan.js (geradas pelo seed-loadtest.ts). Só defina as vars
# abaixo se quiser sobrescrever o default do script.
#
# QR codes de sessões reais do banco de teste, separados por vírgula.
QR_CODES=
# participanteId reais do banco de teste, separados por vírgula (use centenas
# -- o rate limiter é keyado por participanteId, 10 scans/60s cada).
PARTICIPANTE_IDS=
# Cenário de carga: vazao_real (default) ou pico.
SCENARIO=

# Lembrete: no ambiente de destino (staging/preview) é preciso
# ENABLE_LOADTEST_ENDPOINT=true e o middleware (proxy.ts) isentando
# /api/loadtest-scan do gate de sessão. Nunca em produção.
